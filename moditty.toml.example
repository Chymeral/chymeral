[terminal.font]
source = "system"
family = "monospace"
# Medidas en píxeles lógicos: se adaptan automáticamente al DPI del monitor.
size = 16.0
line_height = 20.0
cell_width = "auto"

# Para cargar cualquier fuente que admita el motor desde un archivo local:
# source = "file"
# path = "/ruta/absoluta/a/mi-fuente.otf"
# En Windows también se acepta, por ejemplo, "C:/Users/yo/Fuentes/mi-fuente.otf".
# face_index = 0

[terminal.foreground]
# Color predeterminado del texto que no especifica un color ANSI.
color = "#E5E7EB"

[terminal.background]
kind = "color"
color = "#090B0F"
opacity = 0.92

# Para usar una imagen en lugar del color:
# kind = "image"
# path = "fondos/aurora.gif"
# opacity = 0.72
# fit = "cover"
# fit también puede ser "contain" o "stretch"

# Pantalla de inicio estética opcional. La imagen se muestra centrada sobre la
# terminal y desaparece automáticamente. M5 admite PNG y JPEG estáticos.
[appearance.startup_splash]
enabled = false
# image = "images/moditty-splash.png"
# duration_ms = 1500
# opacity = 1.0

[input.shortcuts]
# Atajos internos de diagnóstico. Cada uno abre una vista modal; Escape vuelve
# a la terminal. Los caracteres escritos mientras la vista está abierta no se
# envían al shell.
diagnostics_events = "Ctrl+Shift+E"
diagnostics_ticks = "Ctrl+Shift+T"
diagnostics_frames = "Ctrl+Shift+F"

# Herramientas internas de prueba. No forman parte de la API de mods y se
# desactivan por defecto. Los nodos se dibujan sobre la terminal en píxeles
# lógicos y participan en hit testing, foco y drag and drop.
[testing_tools.scene]
enabled = false

