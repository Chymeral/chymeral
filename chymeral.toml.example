[terminal.font]
source = "system"
family = "monospace"
# Measurements use logical pixels and adapt automatically to display DPI.
size = 16.0
line_height = 20.0
cell_width = "auto"

# To load any font supported by the engine from a local file:
# source = "file"
# path = "/absolute/path/to/my-font.otf"
# On Windows, for example, "C:/Users/me/Fonts/my-font.otf" is also valid.
# face_index = 0

[terminal.foreground]
# Default color for text that does not specify an ANSI color.
color = "#E5E7EB"

# Optional explicit font aliases for CLP intrinsic scene text. Clients refer to
# an alias, never a host path or system font family. Leave every table disabled
# to use the terminal font for all scene text.
# [scene_text.fonts.ui]
# path = "fonts/ui.otf"
# face_index = 0

[terminal.background]
kind = "color"
color = "#090B0F"
opacity = 0.92

# To use an image instead of a color:
# kind = "image"
# path = "fondos/aurora.gif"
# opacity = 0.72
# fit = "cover"
# fit can also be "contain" or "stretch".

[diagnostics.shortcuts]
# Internal diagnostic shortcuts. Each opens a modal view; Escape returns to the
# terminal. Characters typed while a view is open are not sent to the shell.
diagnostics_events = "Ctrl+Shift+E"
diagnostics_ticks = "Ctrl+Shift+T"
diagnostics_frames = "Ctrl+Shift+F"
