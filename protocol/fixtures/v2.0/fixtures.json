          "kind": "json",
          "message": {
            "type": "command",
            "request_id": "fixture-upload-rgba8",
            "command": {
              "op": "upload_image",
              "source": {
                "kind": "rgba8",
                "width": 1,
                "height": 1
              }
            }
          }
        },
        {
          "direction": "client_to_host",
          "kind": "binary",
          "bytes_hex": "ff8000ff"
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "result",
            "request_id": "fixture-upload-rgba8",
            "result": {
              "kind": "image",
              "image": "image-1"
            }
          }
        },
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "command",
            "request_id": "fixture-create-alpha-image",
            "command": {
              "op": "create_node",
