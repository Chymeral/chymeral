{
  "format": "chymeral-clp-fixture-corpus",
  "fixture_version": 1,
  "protocol": {
    "major": 2,
    "minor": 0
  },
  "transport": {
    "length_prefix": "unsigned 32-bit big-endian payload length including the one-byte discriminator",
    "json_discriminator": "J",
    "binary_discriminator": "B",
    "maximum_frame_bytes": 1048576
  },
  "vectors": [
    {
      "id": "lifecycle-and-subscriptions",
      "description": "A successful full-capability session, its subscription acknowledgement, timing delivery, and clean client close.",
      "frames": [
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "hello",
            "protocol": {
              "major": 2,
              "minor": 0
            },
            "token": "fixture-token-not-a-secret",
            "capabilities": [
              "scene",
              "images",
              "input",
              "timing",
              "overlap",
              "external_drop",
              "text"
            ]
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "init",
            "protocol": {
              "major": 2,
              "minor": 0
            },
            "session_id": "session-1",
            "capabilities": [
              "scene",
              "images",
              "input",
              "timing",
              "overlap",
              "external_drop",
              "text"
            ],
            "context": {
              "arguments": [
                "--fixture"
              ],
              "initial_commands": [
                {
                  "name": "open",
                  "arguments": [
                    "fixture"
                  ]
                }
              ]
            }
          }
        },
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "init_complete"
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "start",
            "session_id": "session-1"
          }
        },
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "started"
          }
        },
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "subscribe",
            "subscriptions": [
              "raw_input",
              "terminal",
              "timing"
            ]
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "subscribed",
            "session_id": "session-1",
            "subscriptions": [
              "raw_input",
              "terminal",
              "timing"
            ]
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "resize",
            "session_id": "session-1",
            "physical_width": 1600,
            "physical_height": 900,
            "logical_width": 800.0,
            "logical_height": 450.0,
            "scale_factor": 2.0
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "tick",
            "session_id": "session-1",
            "dt_ns": "16666667"
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "frame",
            "session_id": "session-1",
            "dt_ns": "16666667"
          }
        },
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "close"
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "closed",
            "session_id": "session-1",
            "reason": {
              "kind": "client_requested"
            }
          }
        }
      ]
    },
    {
      "id": "scene-text-and-overlap",
      "description": "A running session creates visual and intrinsic text nodes, receives an overlap transition, mutates a node atomically, queries contact state, and removes its nodes.",
      "frames": [
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "command",
            "request_id": "fixture-create-rectangle",
            "command": {
              "op": "create_node",
              "layer": "overlay",
              "node": {
                "kind": "rectangle",
                "properties": {
                  "x": 24.0,
                  "y": 32.0,
                  "width": 160.0,
                  "height": 72.0,
                  "visible": true,
                  "clip_children": false,
                  "z_index": 2,
                  "overlap_enabled": true,
                  "external_drop_enabled": false,
                  "input_passthrough": false
                },
                "color": [
                  37,
                  99,
                  235,
                  230
                ]
              }
            }
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "result",
