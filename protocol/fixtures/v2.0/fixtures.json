          }
        },
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "command",
            "request_id": "fixture-create-text",
            "command": {
              "op": "create_node",
              "layer": "overlay",
              "node": {
                "kind": "text",
                "properties": {
                  "x": 48.0,
                  "y": 56.0,
                  "visible": true,
                  "clip_children": false,
                  "z_index": 3,
                  "overlap_enabled": true,
                  "external_drop_enabled": false,
                  "input_passthrough": false
                },
                "text": "Status:\tready\n界",
                "style": {
                  "weight": "bold",
                  "align": "start",
                  "color": [
                    220,
                    230,
                    255,
                    255
                  ]
                }
              }
            }
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "result",
            "request_id": "fixture-create-text",
            "result": {
              "kind": "node",
              "node": "node-2",
              "text_metrics": {
                "columns": 13,
                "rows": 2,
                "width": 104.0,
                "height": 36.0
              }
            }
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "event",
            "session_id": "session-1",
            "event": {
              "kind": "scene",
              "event": {
                "kind": "overlap_enter",
                "first": "node-1",
                "second": "node-2"
              }
            }
          }
        },
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "command",
            "request_id": "fixture-set-rectangle",
            "command": {
              "op": "set_node",
              "node": "node-1",
              "changes": {
                "properties": {
                  "x": 64.0,
                  "input_passthrough": true
                }
              }
            }
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "result",
            "request_id": "fixture-set-rectangle",
            "result": {
              "kind": "node_updated"
            }
          }
        },
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "command",
            "request_id": "fixture-is-overlapping",
            "command": {
              "op": "is_overlapping",
              "node": "node-1"
            }
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "result",
            "request_id": "fixture-is-overlapping",
            "result": {
              "kind": "is_overlapping",
              "overlapping": true
            }
          }
        },
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "command",
            "request_id": "fixture-get-overlaps",
            "command": {
              "op": "get_overlaps",
              "node": "node-1"
            }
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "result",
            "request_id": "fixture-get-overlaps",
            "result": {
              "kind": "overlaps",
              "nodes": [
                "node-2"
              ]
            }
          }
        },
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "command",
            "request_id": "fixture-remove-text",
            "command": {
              "op": "remove_node",
              "node": "node-2"
            }
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "result",
            "request_id": "fixture-remove-text",
            "result": {
              "kind": "acknowledged"
            }
          }
        },
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "command",
            "request_id": "fixture-remove-rectangle",
            "command": {
              "op": "remove_node",
              "node": "node-1"
            }
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "result",
            "request_id": "fixture-remove-rectangle",
            "result": {
              "kind": "acknowledged"
            }
          }
        }
      ]
    },
    {
      "id": "image-upload-and-cleanup",
      "description": "A running session transfers raw RGBA8 and encoded GIF bytes after their upload metadata, creates an alpha-contact image node, then releases all image resources.",
      "frames": [
