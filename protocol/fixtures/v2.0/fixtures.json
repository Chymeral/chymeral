    {
      "id": "delivery-errors-and-fault-close",
      "description": "Representative host notifications, a machine-readable command rejection, and a program-fault termination for a running session.",
      "frames": [
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "event",
            "session_id": "session-1",
            "event": {
              "kind": "scene",
              "event": {
                "kind": "external_drop",
                "target": "node-5",
                "position": {
                  "x": 120.0,
                  "y": 80.0
                },
                "files": [
                  {
                    "uri": "file:///tmp/fixture.txt"
                  }
                ]
              }
            }
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "delivery_gap",
            "session_id": "session-1",
            "categories": [
              "scene",
              "timing"
            ]
          }
        },
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "command",
            "request_id": "fixture-invalid-owner",
            "command": {
              "op": "is_overlapping",
              "node": "node-99"
            }
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "command_error",
            "request_id": "fixture-invalid-owner",
            "code": "not_owner",
            "message": "node-99 is not owned by this session"
          }
        },
        {
          "direction": "client_to_host",
          "kind": "json",
          "message": {
            "type": "fault",
            "phase": "event",
            "message": "fixture program fault"
          }
        },
        {
          "direction": "host_to_client",
          "kind": "json",
          "message": {
            "type": "closed",
            "session_id": "session-1",
            "reason": {
              "kind": "program_fault",
              "phase": "event",
              "message": "fixture program fault"
            }
          }
        }
      ]
    }
  ]
